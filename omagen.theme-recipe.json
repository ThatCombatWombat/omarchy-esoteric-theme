        "glyphs": [
          "⊹",
          "⊕",
          "◉",
          "⊗",
          "✦"
        ]
      },
      "clock": {
        "style": "native"
      },
      "dock": {
        "closed": "ellipsis",
        "glyph": "✦"
      },
      "motion": {
        "preset": "expressive",
        "duration_ms": 160,
        "easing": "out_cubic"
      }
    }
  },
  "animations": {
    "version": 1,
    "preset": "custom",
    "window": "smooth",
    "window_open": "popin",
    "window_close": "fade",
    "window_move": "smooth",
