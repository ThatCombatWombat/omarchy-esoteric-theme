    "Background": "#1a150b",
    "DarkBackground": "#130f07",
    "DarkerBackground": "#0c0a05",
    "LighterBackground": "#282317",
    "Foreground": "#dbd7cd",
    "DarkForeground": "#7d7a72",
    "LightForeground": "#eeebe3",
    "BrightForeground": "#faf8f3",
    "Red": "#9a664a",
    "Yellow": "#897a57",
    "Orange": "#9c6548",
    "Green": "#7d8567",
    "Cyan": "#7d8565",
    "Blue": "#7d8569",
    "Magenta": "#98674c",
    "Brown": "#79715f",
    "BrightRed": "#bb7f5d",
    "BrightYellow": "#a6956c",
    "BrightGreen": "#97a17e",
    "BrightCyan": "#97a17c",
    "BrightBlue": "#97a180",
    "BrightMagenta": "#bd7e5a"
