        "thickness": 0,
        "edge_offset": 0,
        "outer_margin": 0,
        "inner_padding": 0,
        "section_gap": 4,
        "widget_gap": 0,
        "radius": 8,
        "length_mode": "full",
        "length_value": 0,
        "alignment": "center"
      },
      "attention": {
        "mode": "semantic"
      },
      "behavior": {
        "visibility": "always",
        "exclusive_zone": "reserve",
        "hover_expand": false,
        "hide_delay_ms": 5000,
        "reveal_delay_ms": 50,
        "edge_sensor": 3,
        "keep_visible_while_popup_open": true
      },
      "regions": {
        "left": {
          "mode": "native"
        },
        "center": {
          "mode": "native"
        },
        "right": {
          "mode": "native"
        }
      },
      "workspace": {
